# ===== Security =====
AUTH_ENABLED=true
API_KEY=change_me_to_a_strong_api_key
VITE_API_KEY=change_me_to_a_strong_api_key
SECRET_KEY=change_me_to_a_32_plus_character_random_secret
FLASK_DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== RawFish LLM provider router =====
# Modes:
#   local_ollama              -- local Ollama, no external credentials
#   local_openai_compatible   -- local vLLM/LM Studio/llama.cpp server, no external credentials
#   external                  -- explicit external provider/key/model
RAWFISH_LLM_PROVIDER_MODE=local_ollama
RAWFISH_LLM_PROVIDER=
RAWFISH_LLM_MODEL=qwen3-coder:30b
RAWFISH_LLM_BASE_URL=http://localhost:11434/v1
RAWFISH_LLM_API_KEY=
RAWFISH_LLM_READINESS_TIMEOUT_SEC=10
RAWFISH_LLM_GENERATION_TIMEOUT_SEC=120
RAWFISH_LLM_MAX_RETRIES=1

# JSON-mode tier.
#   strict -- send response_format=json_object on every chat call
#   loose  -- send response_format on tier 1, retry without on tier 2
#   off    -- never send response_format
LLM_JSON_MODE=loose
LLM_SUPPORTS_JSON_SCHEMA=false
POLICY_MAX_TOKENS_ONTOLOGY=8192
POLICY_MAX_TOKENS_REPORT=16384

# ===== Audience store =====
ZEP_MODE=mock
ZEP_API_KEY=

# Graphiti / Neo4j, only when ZEP_MODE=graphiti.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Graphiti's local client keeps its library-native env names. Point these
# at a local endpoint for local-first operation.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=local-graphiti-key
OPENAI_MODEL=qwen3-coder:30b
OPENAI_EMBEDDING_MODEL=nomic-embed-text
OPENAI_EMBEDDING_DIM=768
OPENAI_RERANKING_MODEL=qwen3-coder:30b

# ===== Simulation cost ceilings =====
OASIS_DEFAULT_MAX_ROUNDS=150
OASIS_MAX_ROUNDS_CAP=200
OASIS_MAX_AGENTS_CAP=1000
OASIS_ROUND_TIMEOUT_SEC=600
OASIS_RUN_TIMEOUT_SEC=7200
POLICY_ALLOW_EXPENSIVE=false

# ===== Stochasticity layer =====
RAWFISH_RUN_SEED=
RAWFISH_LLM_T_STRUCTURE=0.2
RAWFISH_LLM_T_NARRATIVE=0.7
RAWFISH_ENSEMBLE_N=5

# ===== Idempotency wait window =====
IDEMPOTENCY_WAIT_SECONDS=5
IDEMPOTENCY_CLAIM_TTL_SECONDS=900

# ===== Auto-report watcher =====
AUTO_REPORT_GENERATE=false
